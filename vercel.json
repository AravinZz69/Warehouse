{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/pages/login", "destination": "/pages/login.html" },
    { "source": "/pages/dashboard", "destination": "/pages/dashboard.html" },
    { "source": "/pages/products", "destination": "/pages/products.html" },
    { "source": "/pages/receipts", "destination": "/pages/receipts.html" },
    { "source": "/pages/deliveries", "destination": "/pages/deliveries.html" },
    { "source": "/pages/transfers", "destination": "/pages/transfers.html" }
  ]
}
